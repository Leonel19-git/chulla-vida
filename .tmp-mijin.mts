import { EXPERIENCES } from './src/domain/catalog/index.ts';
import { answerLocally } from './src/features/assistant/knowledge.ts';
import { converse, initialConversation } from './src/features/assistant/conversation.ts';
const ctx = { catalog: [...EXPERIENCES], online: true };
const qs = ['hola','qué tal','quiero ir a la playa','algo barato cerca de Quito','gracias','Tengo $40, ¿qué destinos puedo explorar?','¿Qué fiestas hay en noviembre?','¿Cómo llego a Quilotoa?','¿Cómo verifico mi negocio?','¿Qué puedo descargar para viajar sin señal?','¿Cuál es mi próxima reserva?','¿Puedo pagar con tarjeta?','¿Cuál es la diferencia entre los planes?','¿Dónde sellé mi pasaporte?','Estoy en Baños, tengo 4 horas y 25 dólares, ¿qué hago?','¿Llueve mañana en Quilotoa?','Viajo de Guayaquil con $20 en total, ¿a dónde puedo llegar?','Una vía a Mindo está cerrada, cambia el plan','¿Puedo ir con perro al Parque Nacional Galápagos?','¿Cuánto llega a una comunidad si pago $49?','No tengo internet, explícame mi ruta','No quiero cookies de analítica','Quiero retirar consentimiento de ubicación','Quiero borrar mi audio','¿Cuánto tiempo falta para mi reserva?','¿Qué información guardan de mí?','Quiero conocer Saraguro','quiero conocer cuyabeno','cuanto cuesta el quilotoa','que incluye saraguro','asdf qwer','que es la vida','mi jin quien eres','chao','cuánto cuesta','me gusta la naturaleza','tengo cincuenta dólares y somos tres','quiero algo de aventura en la sierra','dónde queda mindo','cómo estás'];
for (const q of qs) { const a = answerLocally(q, ctx); console.log(`[${a.intent} ${a.confidence?.toFixed(2)}] ${q}\n   → ${a.text}\n   cards: ${a.cards.map(c=>c.title).join(' | ')}`); }
let s = initialConversation();
for (const q of ['hola','salgo de Cuenca','unos 50 dólares','somos 3','2 días','me gusta la playa','no','sí']) { const t = converse(s, q, ctx); s = t.state; console.log(`>> ${q}\n   ${t.redirect ? 'REDIRECT '+t.redirect : t.answer?.text}\n   chips: ${t.answer?.chips?.map(c=>c.label).join(' | ')}\n   cards: ${t.answer?.cards.map(c=>c.title+' ['+(c.reasons??[]).join('; ')+']').join(' | ')}`); }
console.log(JSON.stringify(s.slots));
