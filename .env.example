# Public browser configuration. Copy to .env.local; never put service-role keys in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy public anon JWT is also accepted when no publishable key is set.
VITE_SUPABASE_ANON_KEY=

# Server-only variables. Configure in hosting settings; never expose through Vite.
ANTHROPIC_API_KEY=
ASSISTANT_ENABLED=false
ANTHROPIC_MODEL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
WEATHER_ENABLED=false

# Hosted PayPhone Button. Server only; new checkouts are disabled by default.
# PAYPHONE_TOKEN must belong to a WEB app with this exact authorized domain.
PAYMENTS_ENABLED=false
PAYMENTS_ENVIRONMENT=sandbox
PAYMENTS_APP_URL=http://127.0.0.1:5173
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
# Set true only AFTER selecting the test environment in PayPhone Developer.
# This setting cannot change the provider account's environment by itself.
PAYPHONE_SANDBOX_CONFIRMED=false
# Live additionally requires every commercial_readiness flag in the database.
PAYMENTS_LIVE_ENABLED=false
